{
  "name": "check-version-change",
  "version": "1.3.1",
  "private": true,
  "description": "GitHub Action that compares a local package version with a registry version or another Git ref.",
  "license": "MIT",
  "author": {
    "name": "José F. Ruiz",
    "url": "https://github.com/jfrz38"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrz38/check-version-change.git"
  },
  "bugs": {
    "url": "https://github.com/jfrz38/check-version-change/issues"
  },
  "homepage": "https://github.com/jfrz38/check-version-change#readme",
  "keywords": [
    "github-action",
    "github-actions",
    "version-check",
    "version-compare",
    "release",
    "semver",
    "npm",
    "pypi",
    "maven",
    "crates",
    "golang",
    "vscode"
  ],
  "main": "dist/index.js",
  "type": "commonjs",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --minify --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:coverage": "vitest run --coverage tests/unit",
    "test:smoke": "vitest run tests/smoke --fileParallelism=false",
    "test:acceptance": "vitest run tests/acceptance-tests --fileParallelism=false",
    "validate": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "semver": "7.8.5",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
